# Django Configuration
SECRET_KEY=django-insecure-change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
DB_NAME=scientific_library_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG Configuration (Local Embedded Qdrant & Ollama LLM)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=google/embeddinggemma-300m
# Gated model: accept the Gemma licence on Hugging Face and set a read token
HF_TOKEN=
# Relevance gate; 0.30 for embeddinggemma (use 0.80 for intfloat/e5-small-v2)
RAG_MIN_SIMILARITY_SCORE=0.30
# Changing EMBEDDING_MODEL requires: python manage.py reindex_documents --all
CHUNKING_STRATEGY=hierarchical
# 'dense' (default) or 'rrf_legacy' (previous dense + BM25 fusion)
RAG_RETRIEVAL_MODE=dense
OLLAMA_TEMPERATURE=0
QDRANT_STORAGE_PATH=media/qdrant_db
# Demo option (SETUP.md 3.1): LLM on a Kaggle GPU via demo/kaggle_llm_server.ipynb.
# Set OLLAMA_BASE_URL to the ngrok URL, plus:
# OLLAMA_API_KEY=
# OLLAMA_FALLBACK_URL=http://localhost:11434
# OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Evaluation only (Phase 4 LLM judge, eval/phases/phase_4_generation): Google Gemini API key.
# Not used by the application.
GEMINI_API=
