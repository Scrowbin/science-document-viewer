{
  "venvPath": "backend",
  "venv": "venv",
  "exclude": [
    "scratch",
    "**/scratch",
    "**/tmp",
    "rag_exp",
    "test.py",
    "**/node_modules",
    "**/.venv",
    "**/venv"
  ],
  "extraPaths": [
    "backend",
    "backend/scripts",
    "backend/scripts/downloads",
    "backend/scripts/data_prep",
    "backend/scripts/evaluation",
    "backend/scripts/tools",
    "eval",
    "eval/phases/phase_0_baseline/scripts",
    "eval/phases/phase_3_embedding/scripts",
    "eval/phases/phase_4_indexing/scripts",
    "eval/phases/phase_5_query_processing/scripts",
    "eval/phases/phase_6_hybrid_retrieval/scripts"
  ],
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false,
  "reportAttributeAccessIssue": "none",
  "reportOperatorIssue": "none"
}

