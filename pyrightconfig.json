{
  "venvPath": "backend",
  "venv": "venv",
  "exclude": [
    "scratch",
    "**/scratch",
    "**/tmp",
    "**/node_modules",
    "**/.venv",
    "**/venv"
  ],
  "extraPaths": [
    "backend",
    "backend/scripts",
    "eval",
    "eval/phases/phase_0_baseline/scripts",
    "eval/phases/phase_3_embedding/scripts",
    "eval/phases/phase_6_hybrid_retrieval/scripts",
    "eval/phases/phase_9_generation/scripts",
    "eval/phases/phase_12_combination/scripts"
  ],
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false,
  "reportAttributeAccessIssue": "none",
  "reportOperatorIssue": "none"
}

