{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend",
    "${workspaceFolder}/backend/scripts",
    "${workspaceFolder}/eval",
    "${workspaceFolder}/eval/phases/phase_0_baseline/scripts",
    "${workspaceFolder}/eval/phases/phase_3_embedding/scripts",
    "${workspaceFolder}/eval/phases/phase_6_hybrid_retrieval/scripts",
    "${workspaceFolder}/eval/phases/phase_9_generation/scripts",
    "${workspaceFolder}/eval/phases/phase_12_combination/scripts"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/backend",
    "${workspaceFolder}/backend/scripts",
    "${workspaceFolder}/eval",
    "${workspaceFolder}/eval/phases/phase_0_baseline/scripts",
    "${workspaceFolder}/eval/phases/phase_3_embedding/scripts",
    "${workspaceFolder}/eval/phases/phase_6_hybrid_retrieval/scripts",
    "${workspaceFolder}/eval/phases/phase_9_generation/scripts",
    "${workspaceFolder}/eval/phases/phase_12_combination/scripts"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownArgumentType": "none"
  },
  "python.analysis.exclude": [
    "**/scratch",
    "**/tmp",
    "**/node_modules",
    "**/.venv",
    "**/venv"
  ]
}
