@startdot fig4_09_question_activity_slide
' Slide version of fig4_09 (question handling): three left-to-right rows for a 16:9 slide, with
' node positions pinned. Same steps as fig4_09_question_activity.puml. Render with Graphviz directly:
'   neato -Tpng fig4_09_question_activity_slide.dot -o ../fig4_09_question_activity_slide.png
' (the dot body is everything between @startdot and @enddot)
digraph G {
  layout=neato; dpi=200; splines=ortho; bgcolor=white; pad=0.15;
  node [fontname="Times New Roman,", fontsize=14, shape=box, style=rounded, margin="0.14,0.07"];
  edge [fontname="Times New Roman,", fontsize=12, arrowsize=0.7];

  // row 0 (top): early refusals
  r403   [pos="3.3,4.3!",  label="Trả lỗi 403"];
  rfilt  [pos="5.6,4.3!",  label="Từ chối\n(tục tĩu, nhạy cảm)"];
  rgate  [pos="10.6,4.3!", label="Từ chối,\nkhông gọi LLM"];

  // row 1: checks and retrieval
  start  [pos="0,3!", shape=circle, style=filled, fillcolor=black, label="", width=0.22];
  ask    [pos="1.3,3!",  label="Nhận câu hỏi"];
  perm   [pos="3.3,3!",  shape=diamond, style="", label="Có quyền\nđọc?"];
  filt   [pos="5.6,3!",  shape=diamond, style="", label="Câu hỏi\nhợp lệ?"];
  ret    [pos="8.1,3!",  label="Truy xuất convex,\nmở rộng sang đoạn cha"];
  gate   [pos="10.6,3!", shape=diamond, style="", label="Tương đồng\n≥ 0,30?"];

  // row 2: answer
  prompt [pos="1.9,1.5!",  label="Lời nhắc: chỉ dùng ngữ cảnh,\ntừ chối nếu không đủ"];
  llm    [pos="5.0,1.5!",  label="Mô hình chính\n(GPU, tối đa 40 s)"];
  ok1    [pos="7.3,1.5!",  shape=diamond, style="", label="Có câu\ntrả lời?"];
  cite   [pos="11.0,1.5!", label="Gắn trích dẫn [Page X]"];
  done   [pos="12.7,1.5!", shape=doublecircle, style=filled, fillcolor=black, label="", width=0.14];

  // row 3: fallback
  fb     [pos="7.3,0!",  shape=diamond, style="", label="Có dự\nphòng?"];
  local  [pos="9.15,0!",  label="Ollama cục bộ\n(tối đa 60 s)"];
  ok2    [pos="11.0,0!", shape=diamond, style="", label="Có câu\ntrả lời?"];
  pass   [pos="13.5,0!", label="Trả về trích đoạn\nliên quan nhất + nguồn"];

  start -> ask -> perm;
  perm -> filt [xlabel="có"];
  filt -> ret [xlabel="có"];
  ret -> gate;
  perm -> r403 [xlabel="không"];
  filt -> rfilt [xlabel="không"];
  gate -> rgate [xlabel="không"];

  gate -> prompt [xlabel="có"];
  prompt -> llm -> ok1;
  ok1 -> cite [xlabel="có"];
  cite -> done;

  ok1 -> fb [xlabel="không"];
  fb -> local [xlabel="có   "];
  local -> ok2;
  ok2 -> cite [xlabel="có"];
  ok2 -> pass [xlabel="không  "];
  fb -> pass [xlabel="không có dự phòng"];
}
@enddot
